[Unit]
Description=Raspberry Pi ESP32 Rover Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
SupplementaryGroups=video
WorkingDirectory=/opt/raspberry-pi-rover
EnvironmentFile=-/etc/default/rover-dashboard
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/raspberry-pi-rover/.venv/bin/python /opt/raspberry-pi-rover/app.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
